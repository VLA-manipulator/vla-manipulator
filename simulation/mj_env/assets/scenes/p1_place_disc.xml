<mujoco model="so101_p1_place_disc">
  <!-- P1: pick the cube up and put it down on the marked disc.

       This is the first level that needs a *place* step, so it is the level
       every later one reuses: the O family keeps this exact criterion and only
       adds one geometric difficulty on top.  Naming follows the scene plan --
       the manipulated object is `object` (with `object_free` / `object_geom`),
       the goal carrier is `place_target` (with `place_target_geom` and
       `place_target_site`) -- so the criteria in mj_env/specs/criteria.py and
       the measured envelopes in docs/SO101_ENVELOPE.md apply unchanged.

       Geometry, all from docs/SO101_ENVELOPE.md:
         * 35 mm cube, the easy parallel-face baseline;
         * disc radius 45 mm -- the cube's 35 mm footprint plus a 10 mm ring,
           and small enough that P1 is still a placement task rather than a
           "drop it anywhere near" task;
         * the disc is a zero-collision visual: the cube must rest on the
           *table*, or seat height would depend on the disc radius. -->

  <include file="../../../so101/assets/so101_new_calib.xml"/>
  <!-- Mesh paths are resolved against the directory of the file that declares
       meshdir, and this level scene is the main file, so the path is written
       for `assets/scenes/` (three levels up to the package root).  The robot
       XML declares its own `meshdir="assets"` for when it is loaded directly;
       this declaration wins for the composed model. -->
  <compiler angle="radian" meshdir="../../../so101/assets/assets" autolimits="true"/>

  <include file="../base_table.xml"/>

  <worldbody>
    <!-- Default layout.  mj_env/task_env.py resamples position and yaw at
         every reset inside the M0-measured grasp band (r 0.17~0.30,
         +-60 degrees). -->
    <body name="object" pos="0.220 0.000 0.0175" childclass="table_object">
      <freejoint name="object_free"/>
      <geom name="object_geom" type="box" size="0.0175 0.0175 0.0175" material="object_red"/>
    </body>

    <body name="place_target" pos="0.220 -0.130 0" childclass="decor">
      <geom name="place_target_geom" type="cylinder" size="0.045 0.002"
            pos="0 0 0.002" material="goal_disc"/>
      <site name="place_target_site" pos="0 0 0.004" size="0.005"/>
    </body>
  </worldbody>
</mujoco>