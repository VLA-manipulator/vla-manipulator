<mujoco model="so101_p2_language_ref">
  <!-- P2: two identical-category cubes are on the table and the *instruction*
       says which one to move.  This is the smallest experiment that answers
       "is the language branch being used at all": if a policy trained on both
       instructions picks the same cube whatever it is told, the text is
       decoration.

       Both cubes are 35 mm so that nothing but the colour distinguishes them --
       a size or shape difference would let a policy shortcut the language by
       looking for a silhouette.  Red and yellow are deliberately the two ends
       of the water attenuation curve (see docs/vfx), so this level also shows
       which of the two the imaging axis destroys first.

       Naming follows the scene plan: `object` is the red cube, `object2` the
       yellow one, `place_target` the disc. -->

  <include file="../../../so101/assets/so101_new_calib.xml"/>
  <compiler angle="radian" meshdir="../../../so101/assets/assets" autolimits="true"/>

  <include file="../base_table.xml"/>

  <worldbody>
    <body name="object" pos="0.220 0.110 0.0175" childclass="table_object">
      <freejoint name="object_free"/>
      <geom name="object_geom" type="box" size="0.0175 0.0175 0.0175" material="object_red"/>
    </body>

    <body name="object2" pos="0.240 -0.100 0.0175" childclass="table_object">
      <freejoint name="object2_free"/>
      <geom name="object2_geom" type="box" size="0.0175 0.0175 0.0175" material="object_yellow"/>
    </body>

    <body name="place_target" pos="0.200 0.000 0" childclass="decor">
      <geom name="place_target_geom" type="cylinder" size="0.045 0.002"
            pos="0 0 0.002" material="goal_disc"/>
      <site name="place_target_site" pos="0 0 0.004" size="0.005"/>
    </body>
  </worldbody>
</mujoco>