<mujoco model="so101_p4_stack">
  <!-- P4: the target cube has to end up *on top of* another cube.

       The support is a free body, not scenery, so knocking it over is a failure
       -- that is what makes this more than "place the cube higher up".  The disc
       under it only marks where the support belongs; it carries no collision, so
       the support rests on the tabletop like everything else.

       The stacking height is not written here: the level supplies it through
       TaskSpec.place_height, which measures the support's actual position.  That
       keeps one expert for every level and keeps the height honest if the
       support is ever nudged during settling. -->

  <include file="../../../so101/assets/so101_new_calib.xml"/>
  <compiler angle="radian" meshdir="../../../so101/assets/assets" autolimits="true"/>

  <include file="../base_table.xml"/>

  <worldbody>
    <body name="object" pos="0.220 0.110 0.0175" childclass="table_object">
      <freejoint name="object_free"/>
      <geom name="object_geom" type="box" size="0.0175 0.0175 0.0175" material="object_red"/>
    </body>

    <body name="support" pos="0.210 -0.110 0.0175" childclass="table_object">
      <freejoint name="support_free"/>
      <geom name="support_geom" type="box" size="0.0175 0.0175 0.0175" material="object_yellow"/>
    </body>

    <body name="place_target" pos="0.210 -0.110 0" childclass="decor">
      <geom name="place_target_geom" type="cylinder" size="0.045 0.002"
            pos="0 0 0.002" material="goal_disc"/>
      <site name="place_target_site" pos="0 0 0.004" size="0.005"/>
    </body>
  </worldbody>
</mujoco>