<mujoco model="so101_o4_narrow_slot">
  <!-- O4: the cube sits between two guide walls, and the hand has to go in
       between them.  Its only difficulty axis is lateral precision: the walls
       are taller than the cube, so the whole descent is constrained.

       Wall separation comes from the M0-measured hand outline
       (docs/SO101_ENVELOPE.md).  The jaw at the descent aperture spans 82.8 mm,
       but **asymmetrically about the aperture centre**: 48.9 mm out on the
       fixed-finger side and 33.9 mm on the moving-jaw side.  A "90 mm slot"
       would therefore be a collision, not a tight fit.  The slot is centred on
       the aperture, so its half-width has to clear the wider side:
       ``wall_offset = 48.9 + 4 mm margin -> 53 mm``, i.e. a 106 mm slot.

       The walls rotate with the object (see mj_env/specs/family_o.py), so the
       clearance does not depend on the object's random heading. -->

  <include file="../../../so101/assets/so101_new_calib.xml"/>
  <compiler angle="radian" meshdir="../../../so101/assets/assets" autolimits="true"/>

  <include file="../base_table.xml"/>

  <worldbody>
    <body name="object" pos="0.220 0.000 0.0175" childclass="table_object">
      <freejoint name="object_free"/>
      <geom name="object_geom" type="box" size="0.0175 0.0175 0.0175" material="object_red"/>
    </body>

    <body name="place_target" pos="0.220 -0.130 0" childclass="decor">
      <geom name="place_target_geom" type="cylinder" size="0.045 0.002"
            pos="0 0 0.002" material="goal_disc"/>
      <site name="place_target_site" pos="0 0 0.004" size="0.005"/>
    </body>

    <!-- Guide walls.  Default pose is only a sensible starting point: the
         layout places and rotates them every reset.  Half-extents are
         (length/2, thickness/2, height/2): the length runs along the object's
         local x, and the walls are separated along its local **y** -- the
         direction the jaw closes across, which is the tighter of the two
         (48.9 mm out on the fixed-finger side).  The wall never reaches the
         goal disc, which is at least 100 mm away. -->
    <body name="slot_wall_neg" pos="0.167 0.000 0.0225" childclass="structure">
      <geom name="slot_wall_neg_geom" type="box" size="0.050 0.003 0.0225"/>
    </body>
    <body name="slot_wall_pos" pos="0.273 0.000 0.0225" childclass="structure">
      <geom name="slot_wall_pos_geom" type="box" size="0.050 0.003 0.0225"/>
    </body>
  </worldbody>
</mujoco>